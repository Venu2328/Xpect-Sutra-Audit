export default async function handler(req, res) {
  const API_KEY = process.env.GEMINI_API_KEY; 
  const { rowData } = req.body;

  const response = await fetch(`https://generativelanguage.googleapis.com/v1beta/models/gemini-1.5-flash:generateContent?key=${API_KEY}`, {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({
      contents: [{ parts: [{ text: `You are the Xpect AI Auditor. Audit this data against the RBI 7 Sutras (Trust, Fairness, Accountability, Safety, Transparency, Innovation, Human-Centricity). Briefly explain if it's compliant: ${rowData}` }] }]
    })
  });

  const data = await response.json();
  res.status(200).json(data);
}

